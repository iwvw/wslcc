<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLCC.App.Pages.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WSLCC.App.ViewModels"
    xmlns:controls="using:WSLCC.App.Controls"
    mc:Ignorable="d"
    x:DataType="vm:ComposeViewModel">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Compose 部署" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="管理通过 docker-compose.yml 部署的项目" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="刷新" />
                <Button
                    Click="Deploy_Click"
                    Content="新建 / 部署 Compose" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="操作失败" />

        <Grid Grid.Row="2">
            <Grid x:Name="ListPanel">
                <controls:SkeletonGrid IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="暂无 Compose 项目，点击右上角新建 / 部署 Compose 开始"
                    Visibility="{x:Bind ViewModel.HasProjects, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />
                <ListView
                    ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasProjects, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComposeProjectItemViewModel">
                            <Border
                                Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Summary}" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind FilePath}" />
                                        <TextBlock
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            MaxLines="3"
                                            TextTrimming="CharacterEllipsis"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind ServicesText}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            Click="OpenFolder_Click"
                                            Content="打开目录"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind HasFilePath, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                        <Button
                                            Click="EditProject_Click"
                                            Content="编辑"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Click="StopProject_Click"
                                            Content="停止项目"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Click="RestartProject_Click"
                                            Content="重启"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Click="RebuildProject_Click"
                                            Content="重建"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Click="DeleteProject_Click"
                                            Content="删除项目"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="EditorTitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="EditorPathText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="EditorCancel_Click"
                        Content="返回列表" />
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,12,0,8"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBox
                        x:Name="ProjectNameBox"
                        Width="220"
                        PlaceholderText="留空自动生成"
                        Header="项目名称（目录）"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="MirrorBox"
                        Width="320"
                        Header="镜像加速源"
                        PlaceholderText="如 docker.1panel.live"
                        Visibility="Collapsed" />
                    <Button
                        Click="EditorLoad_Click"
                        VerticalAlignment="Bottom"
                        Content="从文件加载" />
                </StackPanel>

                <RichEditBox
                    x:Name="EditorBox"
                    Grid.Row="2"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    FontFamily="Consolas"
                    FontSize="13" />

                <StackPanel
                    Grid.Row="3"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="EditorPrimary_Click"
                        x:Name="EditorPrimaryBtn"
                        Content="保存" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
