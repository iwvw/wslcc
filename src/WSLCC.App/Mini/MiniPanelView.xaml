<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WSLCC.App.Mini.MiniPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WSLCC.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WSLCC.App.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Storyboard x:Name="RefreshSpin" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="RefreshRotate"
                Storyboard.TargetProperty="Angle"
                From="0"
                To="360"
                Duration="0:0:0.9" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Padding="18,14,18,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="SolidBackdrop"
            Grid.RowSpan="3"
            Margin="-18,-14,-18,-16"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed" />

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Title}" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                MinWidth="0"
                MinHeight="0"
                Padding="6,4"
                Background="Transparent"
                BorderThickness="0"
                Click="Refresh_Click"
                ToolTipService.ToolTip="{x:Bind RefreshTooltip}">
                <FontIcon
                    x:Name="RefreshIcon"
                    FontSize="13"
                    Glyph="&#xE72C;"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform x:Name="RefreshRotate" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="300"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="{x:Bind EmptyText}"
                Visibility="{x:Bind ViewModel.HasContainers, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

            <ListView
                Padding="0"
                ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasContainers, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContainerItemViewModel">
                        <Border
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="8" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Ellipse
                                    Width="8" Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Ellipse
                                    Width="8" Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind Name, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="OpenWeb_Click"
                                        Content="打开"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind HasWebUrl, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="Start_Click"
                                        Content="启动"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="Stop_Click"
                                        Content="停止"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="Restart_Click"
                                        Content="重启"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind Status, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind ResourceText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                MinWidth="0"
                MinHeight="0"
                Padding="8,3"
                Click="OpenFull_Click"
                Content="{x:Bind OpenFullText}" />
        </Grid>
    </Grid>
</UserControl>
