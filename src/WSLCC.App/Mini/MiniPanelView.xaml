<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WSLCC.App.Mini.MiniPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WSLCC.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WSLCC.App.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="MiniIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        </Style>
        <Style x:Key="MiniStopButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="16,12,16,12" RowSpacing="10" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="SolidBackdrop"
            Grid.RowSpan="3"
            Margin="-16,-12,-16,-12"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed" />

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Title}" />
            <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center">
                <ProgressRing
                    Width="16" Height="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <Button
                    x:Name="RefreshButton"
                    Style="{StaticResource MiniIconButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                    ToolTipService.ToolTip="{x:Bind RefreshTooltip}"
                    Click="Refresh_Click">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>
            </Grid>
            <Grid Grid.Column="3" Width="28" Height="28" VerticalAlignment="Center">
                <ProgressRing
                    Width="16" Height="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsSessionBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsSessionBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <Button
                    x:Name="SessionStopButton"
                    Style="{StaticResource MiniStopButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsSessionRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    ToolTipService.ToolTip="{x:Bind SessionStopTooltip}"
                    Click="SessionToggle_Click">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B02616" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#9B2113" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D13423" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B02616" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <FontIcon FontSize="12" Foreground="White" Glyph="&#xE71A;" />
                </Button>
                <Button
                    x:Name="SessionStartButton"
                    Style="{StaticResource MiniIconButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsSessionRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                    ToolTipService.ToolTip="{x:Bind SessionStartTooltip}"
                    Click="SessionToggle_Click">
                    <FontIcon FontSize="12" Glyph="&#xE768;" />
                </Button>
            </Grid>
            <Button
                Grid.Column="4"
                MinWidth="0"
                MinHeight="0"
                Padding="10,4"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="打开主界面"
                Click="OpenFull_Click"
                Content="{x:Bind OpenFullText}" />
            <Button
                Grid.Column="5"
                Width="28" Height="28" Padding="0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                ToolTipService.ToolTip="收起"
                Click="Collapse_Click">
                <FontIcon FontSize="12" Glyph="&#xE70D;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="300"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="{x:Bind EmptyText}"
                Visibility="{x:Bind ViewModel.HasContainers, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

            <ListView
                Padding="0"
                ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasContainers, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContainerItemViewModel">
                        <Border
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="8" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Ellipse
                                    Grid.Column="0"
                                    Width="8" Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Ellipse
                                    Grid.Column="0"
                                    Width="8" Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind Name, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <Image
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind IconSource, Mode=OneWay}"
                                        Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="OpenWeb_Click"
                                        Content="打开"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind HasWebUrl, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="Start_Click"
                                        Content="启动"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="Stop_Click"
                                        Content="停止"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="6,3"
                                        Click="Restart_Click"
                                        Content="重启"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind Status, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind ResourceText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
